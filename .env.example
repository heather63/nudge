# Discord bot token from https://discord.com/developers/applications
NUDGE_DISCORD_TOKEN=
# Your own Discord user ID (enable Developer Mode, right-click yourself, Copy User ID)
NUDGE_DISCORD_USER_ID=
NUDGE_LOG_LEVEL=INFO
# IANA timezone for quiet hours and "today" (default America/New_York)
# NUDGE_TIMEZONE=America/New_York

# optional: override where the Google OAuth files live
# NUDGE_GOOGLE_CREDENTIALS=credentials.json
# NUDGE_GOOGLE_TOKEN=token.json

# Anthropic API key, used only to size assignments from their documents
ANTHROPIC_API_KEY=
